{
  "name": "cosmo-browser",
  "version": "0.3.1",
  "private": true,
  "description": "Cosmo Browser: Tauri, Rust and native WebViews for Windows and Android",
  "author": "CosmoNet",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tauri dev",
    "tauri": "tauri",
    "prepare:app": "node tools/python.cjs tools/prepare-app-assets.py",
    "build:windows": "tauri build --bundles nsis",
    "build:android": "tauri android build --apk --target aarch64 --ci",
    "secrets:scan": "node tools/python.cjs tools/security-scan.py",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/extension-browser.cjs",
    "test:ui": "node tests/browser-ui.cjs",
    "test:upstream": "node tools/python.cjs -m unittest discover -s tests -p test_*.py -v",
    "doctor": "node tools/python.cjs tools/chromium.py doctor",
    "extensions:pack": "node tools/python.cjs tools/package-extensions.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "eruda": "3.4.3",
    "playwright": "1.65.1"
  }
}
